# ==============================================================================
# BALAGHNI — Production Environment Variables Template (.env.example)
# NEVER commit real secrets, API keys, tokens, or production credentials.
# ==============================================================================

# 1. Supabase Database & Auth (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only Service Role Key (Required for supabaseAdmin, OTP, Rate Limiter, Worker)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Cryptographic Signing & HKDF Key Versioning (Required in Production)
# Generate with: openssl rand -hex 32 (minimum 32 bytes; standalone in Production)
SESSION_HMAC_SECRET=your_random_32_byte_hex_secret_here
SESSION_HMAC_KEY_VERSION=1
# Optional independent HKDF key versions (default to SESSION_HMAC_KEY_VERSION)
SESSION_PHONE_HMAC_KEY_VERSION=1
SESSION_OTP_HMAC_KEY_VERSION=1
SESSION_ENC_KEY_VERSION=1
# Optional during zero-downtime key rotation ONLY (remove once check_key_version_active_usage=0)
# SESSION_HMAC_SECRET_PREVIOUS=your_previous_32_byte_hex_secret_here
# SESSION_HMAC_PREVIOUS_KEY_VERSION=1

# Cron & Worker Bearer Authentication Secret (Required, >= 32 bytes)
CRON_SECRET=your_random_32_byte_cron_secret_here

# 3. Trusted Application Origins & Support Numbers
NEXT_PUBLIC_SITE_URL=https://balaghni.ly
APP_URL=https://balaghni.ly
ALLOWED_ADMIN_ORIGINS=https://balaghni.ly,https://www.balaghni.ly
# Official support & admin WhatsApp numbers in international digits (e.g. 2189XXXXXXXX)
# Leave empty to hide public support WhatsApp buttons until configured
NEXT_PUBLIC_SUPPORT_WHATSAPP=
ADMIN_WHATSAPP_NUMBER=
# Set to "true" ONLY if deployed behind a trusted reverse proxy outside Vercel
TRUST_PROXY_HEADERS=false

# 4. Twilio WhatsApp Primary Provider & Webhooks (Required for WhatsApp)
WHATSAPP_ACTIVE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid_here
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_WEBHOOK_URL=https://balaghni.ly/api/webhooks/whatsapp
TWILIO_WHATSAPP_STATUS_WEBHOOK_URL=https://balaghni.ly/api/webhooks/whatsapp-status
# Twilio Approved WhatsApp Content Template SIDs (Required in Production — no hardcoded fallbacks)
TWILIO_CONTENT_SID_OTP=your_twilio_otp_content_sid_here
TWILIO_CONTENT_SID_ALERT=your_twilio_alert_content_sid_here
TWILIO_CONTENT_SID_MEDIA_ALERT=your_twilio_media_alert_content_sid_here
TWILIO_CONTENT_SID_VOICE_CALL=your_twilio_voice_call_content_sid_here
TWILIO_CONTENT_SID_REMIND=your_twilio_remind_content_sid_here
TWILIO_CONTENT_SID_SUBSCRIPTION=your_twilio_subscription_content_sid_here
TWILIO_CONTENT_SID_DOC_REMINDER=your_twilio_doc_reminder_content_sid_here
TWILIO_CONTENT_SID_WEEKLY_OVERDUE=your_twilio_weekly_overdue_content_sid_here
TWILIO_CONTENT_SID_ORDER_COD=your_twilio_order_cod_content_sid_here
TWILIO_CONTENT_SID_ORDER=your_twilio_order_content_sid_here
TWILIO_CONTENT_SID_ORDER_ACTIVATED=your_twilio_order_activated_content_sid_here
TWILIO_CONTENT_SID_STICKER_LINKED=your_twilio_sticker_linked_content_sid_here
TWILIO_CONTENT_SID_GIFT_ACTIVATED=your_twilio_gift_activated_content_sid_here
TWILIO_CONTENT_SID_ADMIN_ALERT=your_twilio_admin_alert_content_sid_here

# 5. Resala SMS Fallback Provider (Required for SMS OTP & Fallback)
RESALA_API_KEY=your_resala_api_key_here
# Required in Production (Fail-Closed; must be HTTPS base URL — no silent dev fallback)
RESALA_ENDPOINT=https://your-resala-production-endpoint.example/api/v1
# Approved Resala production domain allowlist (Required in Production; must match hostname exactly)
# RESALA_APPROVED_HOSTNAMES=your_approved_resala_hostname_here
# Optional explicit development-only Resala endpoint (NEVER read in Production)
# RESALA_DEV_ENDPOINT=https://your-resala-dev-endpoint.example/api/v1
# Required for unified single-OTP WhatsApp->SMS fallback via /messages/send-template
# Template MUST accept variable $1 for the 6-digit OTP code.
RESALA_OTP_TEMPLATE_ID=your_approved_resala_otp_template_uuid_here
RESALA_SMS_TEMPLATE_ID=your_resala_alert_template_uuid_here
RESALA_REMINDER_TEMPLATE_ID=your_resala_reminder_template_uuid_here
RESALA_SUBSCRIPTION_TEMPLATE_ID=your_resala_subscription_template_uuid_here

# 6. Optional Meta WhatsApp Cloud API (DISABLED BY DEFAULT — Future Fallback Provider Only)
# Twilio is the primary WhatsApp provider. Meta outbound is strictly disabled by default in production (fail-closed).
# Meta outbound sending CANNOT be enabled by merely providing access tokens.
# Activating Meta in the future requires:
#   1. Explicit administrative & architectural approval
#   2. Independent security audit approval
#   3. WHATSAPP_ACTIVE_PROVIDER=meta
#   4. ENABLE_META_WHATSAPP_PROVIDER=true
#   5. META_SECURITY_REVIEW_APPROVED=true
# Webhook verification keys below are preserved solely for receiving incoming webhooks / status events.
WHATSAPP_APP_SECRET=your_meta_whatsapp_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
# WHATSAPP_ACTIVE_PROVIDER=twilio
# ENABLE_META_WHATSAPP_PROVIDER=false
# META_SECURITY_REVIEW_APPROVED=false
# WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# 7. Optional AI Office (Only if AI Office agents are enabled in Production)
# GEMINI_API_KEY=your_gemini_api_key_here
# POSTGRES_URL_NON_POOLING=postgres://user:pass@host:5432/postgres
