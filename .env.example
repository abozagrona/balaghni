# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key for server-side admin operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_MASTER_PIN=your_admin_master_pin_here
ADMIN_MASTER_SECRET=your_admin_master_secret_here

# Green-API WhatsApp Credentials (Server-side only)
GREEN_API_URL=https://7107.api.greenapi.com
GREEN_API_INSTANCE_ID=your_instance_id_here
GREEN_API_INSTANCE=your_instance_id_here
GREEN_API_TOKEN=your_green_api_token_here

# Resala SMS API Credentials (Server-side only)
RESALA_API_KEY=your_resala_api_key_here
RESALA_ENDPOINT=https://dev.resala.ly/api/v1/pins

# WhatsApp Meta Webhook (Optional)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here
